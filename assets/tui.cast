[0.001, "o", "└──────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[2;2H─ [2]* \u001b[2;94H[-][x]\u001b[3;2H                                                                                                  \u001b[3;2HMara left Mill farm at dawn on Day 1, thinking of @Joren.\u001b[0m\u001b[4;2H                                                                                                  \u001b[4;2HThe road was empty except for @Entity000, @Entity001, @Entity002, @Entity003, @Entity004, \u001b[0m\u001b[5;2H                                                                                                  \u001b[5;2H@Entity005, @Entity006, @Entity007, who argued about the Day 1 market.\u001b[0m\u001b[6;2H                                                                                                  \u001b[6;2H"]
[0.000, "o", "\"Tell @Joren I was here,\" Mara said, \"and keep it quiet.\"\u001b[0m\u001b[7;2H                                                                                                  \u001b[7;2HBy nightfall the Day 1 entry was done.\u001b[0m\u001b[8;2H                                                                                                  \u001b[8;2H\u001b[9;2H                                                                                                  \u001b[9;2H~\u001b[10;2H                                                                                                  \u001b[10;2H~\u001b[11;2H                                                                                                  \u001b[11;2H~\u001b[12;2H                                                                                                  \u001b[12;2H~\u001b[13;2H                                                                                                  \u001b[13;2H~\u001b[14;2H                                                                                                  \u001b[14;2H~\u001b[15;2H                  "]
