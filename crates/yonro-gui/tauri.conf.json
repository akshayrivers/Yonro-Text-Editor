{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonro",
  "version": "1.0.0",
  "identifier": "studio.yonro.app",
  "build": {
    "frontendDist": "ui",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,    "windows": [
      {
        "title": "Yonro — Narrative Studio",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
